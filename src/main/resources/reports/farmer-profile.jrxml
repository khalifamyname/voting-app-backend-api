	<queryString>
		<![CDATA[SELECT t2.description AS farm, CONCAT(CURRENT_DATE) AS startdate, CONCAT(CURRENT_DATE) AS enddate, 0.0 AS farmsize
FROM st_farmers AS t1
LEFT JOIN public.st_farmer_farms AS t3 ON t1.id = t3.farmer_id
LEFT JOIN tx_farms AS t2 ON t3.farm_id = t2.id
WHERE t1.uuid = '6e955791-9511-4b26-baa8-761125d1f43c']]>
	</queryString>
